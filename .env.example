# "mock" runs entirely on data/mock_*.json with zero API keys required.
# "live" pulls real prices (yfinance/CoinGecko) and real news (NewsAPI).
MARKET_WATCHER_MODE=mock

# Required only for live news mode. Free tier: https://newsapi.org
NEWSAPI_KEY=

# Required for real LLM reasoning verdicts. Without EITHER key below,
# reasoning_agent.py falls back to a transparent rule-based mock (clearly
# labeled [MOCK] in output).
#
# Gemini is used automatically if GEMINI_API_KEY is set (checked first -
# its free tier has much higher rate/token limits than Groq's).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Used only if GEMINI_API_KEY is not set. Get one at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: force a specific provider instead of auto-detecting from
# whichever key is set above. Values: "gemini" or "groq".
LLM_PROVIDER=
